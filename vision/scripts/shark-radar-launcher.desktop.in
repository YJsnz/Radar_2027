[Desktop Entry]
Type=Application
Version=1.0
Name=Match Control Center
Name[zh_CN]=比赛控制中心
Comment=Configure, calibrate, and start the match vision system
Comment[zh_CN]=配置、标定并启动比赛视觉系统
Exec="@START_SCRIPT@"
TryExec=@START_SCRIPT@
Path=@PROJECT_ROOT@
Terminal=false
StartupNotify=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=2
Categories=Utility;
